{
  "name": "recstead",
  "version": "1.0.0-beta.0",
  "description": "Browser microphone recording with explicit session and resource lifetimes.",
  "type": "module",
  "license": "MIT",
  "author": "Trigger",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trigger-xyz/recstead.git"
  },
  "bugs": {
    "url": "https://github.com/trigger-xyz/recstead/issues"
  },
  "homepage": "https://github.com/trigger-xyz/recstead#readme",
  "keywords": [
    "audio",
    "microphone",
    "mediarecorder",
    "recording",
    "typescript",
    "react"
  ],
  "files": [
    "dist",
    "docs",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.12"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "next",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "typecheck": "node scripts/typecheck.mjs",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test --test-timeout=120000 tests/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "check:privacy": "node scripts/check-privacy.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run check:privacy && npm run check:package",
    "demo": "node scripts/demo.mjs",
    "prepublishOnly": "npm run check:all",
    "build:examples": "npm run build && vite build --config examples/vite.config.mjs",
    "prepack": "npm run build",
    "release:prepare": "npm run check:all && node scripts/prepare-release.mjs",
    "lint": "eslint . --max-warnings 0",
    "test:browser": "node scripts/test-browser.mjs",
    "test:browser:published": "node scripts/test-browser.mjs --published",
    "check:all": "npm run check && npm run test:browser && npm run check:consumers",
    "test:browser:container": "node scripts/test-browser-container.mjs",
    "check:consumers": "node scripts/check-consumers.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "fake-indexeddb": "6.2.8",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "typescript-7": "npm:typescript@7.0.2",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  },
  "allowScripts": {
    "esbuild": false,
    "fsevents": false
  }
}
